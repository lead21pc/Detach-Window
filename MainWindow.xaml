<Window x:Class="ExplorerWorkspace.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Explorer Workspace" Width="760" Height="520"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Refresh" Width="86" Margin="0,0,8,0" Click="Refresh_Click"/>
            <Button Content="Attach" Width="86" Margin="0,0,8,0" Click="Attach_Click"/>
            <Button Content="Detach" Width="86" Margin="0,0,8,0" Click="Detach_Click"/>
            <Button Content="Save" Width="86" Margin="0,0,8,0" Click="Save_Click"/>
            <Button Content="Restore" Width="86" Margin="0,0,18,0" Click="Restore_Click"/>
            <TextBlock VerticalAlignment="Center" Text="Layout:" Margin="0,0,6,0"/>
            <ComboBox x:Name="LayoutBox" Width="130" SelectedIndex="0">
                <ComboBoxItem Content="Auto Grid"/>
                <ComboBoxItem Content="Horizontal"/>
                <ComboBoxItem Content="Vertical"/>
            </ComboBox>
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" x:Name="StatusText" Margin="0,10,0,0" TextWrapping="Wrap"/>

        <ListView x:Name="ExplorerList" SelectionMode="Extended">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Title" Width="260" DisplayMemberBinding="{Binding Title}"/>
                    <GridViewColumn Header="Folder" Width="340" DisplayMemberBinding="{Binding Folder}"/>
                    <GridViewColumn Header="HWND" Width="110" DisplayMemberBinding="{Binding HwndHex}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
